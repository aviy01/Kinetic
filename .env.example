# ========================================
# CaloryTracker Pro - Environment Variables
# ========================================
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to version control

# ========================================
# SUPABASE CONFIGURATION
# ========================================
# Get these from: supabase.com > Project Settings > API

# Your Supabase project URL
VITE_SUPABASE_URL=https://your-project-name.supabase.co

# Supabase Anonymous Key (public)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ========================================
# GOOGLE OAUTH CONFIGURATION (Optional)
# ========================================
# Get these from: Google Cloud Console > APIs & Services > Credentials

# Google OAuth 2.0 Client ID
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ========================================
# FOOD API CONFIGURATION
# ========================================
# Choose one of these APIs:
# 1. USDA FoodData Central: https://fdc.nal.usda.gov/api-guide.html
# 2. Nutritionix: https://www.nutritionix.com/business/api
# 3. Edamam: https://developer.edamam.com/

# Base URL for Food API
VITE_FOOD_API_BASE_URL=https://fdc.nal.usda.gov/api/foods

# API Key for Food API
VITE_FOOD_API_KEY=your-food-api-key-here

# ========================================
# APP CONFIGURATION
# ========================================

# Application name
VITE_APP_NAME=CaloryTracker Pro

# Application version
VITE_APP_VERSION=1.0.0

# Debug mode (true/false)
VITE_DEBUG_MODE=false

# ========================================
# ANALYTICS (Optional)
# ========================================

# Google Analytics ID (if using)
VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# ========================================
# SENTRY ERROR TRACKING (Optional)
# ========================================

# Sentry DSN for error tracking
VITE_SENTRY_DSN=https://key@sentry.io/project-id
